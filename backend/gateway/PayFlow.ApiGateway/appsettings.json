{
  "AllowedHosts": "*",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ReverseProxy": {
    "Routes": {

      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },

      "user-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/User/{**catch-all}"
        }
      },

      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }
      },

      "wallet-route": {
        "ClusterId": "wallet-cluster",
        "Match": {
          "Path": "/api/wallet/{**catch-all}"
        }
      },

      "fraud-route": {
        "ClusterId": "fraud-cluster",
        "Match": {
          "Path": "/api/fraud/{**catch-all}"
        }
      },

      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notification/{**catch-all}"
        }
      }

    },

    "Clusters": {

      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7093/"
          }
        }
      },

      "payment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7009/"
          }
        }
      },

      "wallet-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7224/"
          }
        }
      },

      "fraud-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7169/"
          }
        }
      },

      "notification-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7136/"
          }
        }
      }

    }
  }
}