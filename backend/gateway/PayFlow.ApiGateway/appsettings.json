{
  "AllowedHosts": "*",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ReverseProxy": {
    "Routes": {

      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/Auth/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/Payment/{**catch-all}"
        }
      },
      "wallet-route": {
        "ClusterId": "wallet-cluster",
        "Match": {
          "Path": "/api/Wallet/{**catch-all}"
        }
      },
      "fraud-route": {
        "ClusterId": "fraud-cluster",
        "Match": {
          "Path": "/api/Fraud/{**catch-all}"
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/Notification/{**catch-all}"
        }
      }

    },

    "Clusters": {

      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://payflow-auth-service-ux0o.onrender.com"
          }
        }
      },

      "payment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://payflow-payment-service-gcal.onrender.com"
          }
        }
      },

      "wallet-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://payflow-wallet-service-7kvm.onrender.com"
          }
        }
      },

      "fraud-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://payflow-fraud-service-ja5a.onrender.com"
          }
        }
      },

      "notification-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://payflow-notification-service-jaht.onrender.com"
          }
        }
      }

    }
  }
}